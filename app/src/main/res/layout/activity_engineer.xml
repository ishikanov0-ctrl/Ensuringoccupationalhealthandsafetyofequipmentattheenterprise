<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Панель инструктора"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnCreateTraining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Создание инструктажей"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnAssignTraining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Назначение инструктажей"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnControlTraining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Контроль инструктажей"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnAnalyzeTests"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Анализ тестов"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnViewReports"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Просмотр отчета"
        android:layout_marginBottom="8dp" />
</LinearLayout>