<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.ensuringoccupationalhealthandsafetyofequipmentattheenterprise">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ensuringoccupationalhealthandsafetyofequipmentattheenterprise">

        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".WorkerActivity" android:exported="false" />
        <activity android:name=".EngineerActivity" android:exported="false" />
        <activity android:name=".AdminActivity" android:exported="false" />

        <activity android:name=".InstructionDetailActivity"
            android:exported="false"
            android:parentActivityName=".WorkerActivity" />
        <activity android:name=".TrainingDetailActivity"
            android:exported="false"
            android:parentActivityName=".WorkerActivity" />
        <activity android:name=".TestActivity"
            android:exported="false"
            android:parentActivityName=".WorkerActivity" />
        <activity android:name=".TestResultsActivity"
            android:exported="false"
            android:parentActivityName=".TestActivity" />

        <!-- Активности инженера (дочерние) -->
        <activity android:name=".CreateTrainingActivity"
            android:exported="false"
            android:parentActivityName=".EngineerActivity" />
        <activity android:name=".AssignTrainingActivity"
            android:exported="false"
            android:parentActivityName=".EngineerActivity" />
        <activity android:name=".ControlTrainingActivity"
            android:exported="false"
            android:parentActivityName=".EngineerActivity" />
        <activity android:name=".AnalyzeTestsActivity"
            android:exported="false"
            android:parentActivityName=".EngineerActivity" />
        <activity android:name=".ViewReportsActivity"
            android:exported="false"
            android:parentActivityName=".EngineerActivity" />

        <activity android:name=".ManageUsersActivity"
            android:exported="false"
            android:parentActivityName=".AdminActivity" />
        <activity android:name=".SetPermissionsActivity"
            android:exported="false"
            android:parentActivityName=".AdminActivity" />
        <activity android:name=".SystemMaintenanceActivity"
            android:exported="false"
            android:parentActivityName=".AdminActivity" />

    </application>
</manifest>